TELEMETRY_API_URL=https://stats-api-robyn.a3slabs.co.ke/api

# Required in production. Leave empty only when running `next dev` locally.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Required when TELEMETRY_API_URL is protected by a Cloudflare Service Auth policy.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Server-only operational access. Never prefix these values with NEXT_PUBLIC_.
TELEMETRY_WRITE_TOKEN=
ISTATUS_OPERATOR_EMAILS=
ISTATUS_ADMIN_EMAILS=

# Required only when running the Cloudflare Tunnel service with Docker Compose.
# Create a tunnel in Cloudflare Zero Trust and paste its token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Access application protecting the dashboard.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Service token for the Access application protecting the telemetry backend.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Generate with: openssl rand -hex 32
# Shared only by the Next.js and Robyn containers. Do not expose this in NEXT_PUBLIC_*.
TELEMETRY_WRITE_TOKEN=

# Bootstrap role floors for Cloudflare Access identities. Managed roles and
# profiles are stored in the backend telemetry-data volume; unlisted users are viewers.
ISTATUS_OPERATOR_EMAILS=
ISTATUS_ADMIN_EMAILS=

# History retention and built-in alert thresholds.
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_SAMPLE_INTERVAL_SECONDS=15
ALERT_CPU_PERCENT=85
ALERT_MEMORY_PERCENT=85
ALERT_DISK_PERCENT=90
ALERT_RESTART_COUNT=3

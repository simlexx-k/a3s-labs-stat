# Required only when running the Cloudflare Tunnel service with Docker Compose.
# Create a tunnel in Cloudflare Zero Trust and paste its token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Access application protecting the dashboard.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Service token for the Access application protecting the telemetry backend.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
